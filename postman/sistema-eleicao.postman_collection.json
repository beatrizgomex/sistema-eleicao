              ]
            },
            "description": "Autentica um candidato previamente cadastrado pelo Chefe da Seção e salva o JWT em {{token}}."
          },
          "response": []
        },
        {
          "name": "Consultar Usuário Autenticado (/auth/me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{urlBase}}/auth/me",
              "host": [
                "{{urlBase}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Valida o token Bearer atual salvo em {{token}} e retorna {id, login, perfil}."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "urlBase",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    }
  ]
}
